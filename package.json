{
  "name": "tapis",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n serveur,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w @tapis/engine"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Poker Texas Hold'em entre amis, en temps réel, sur téléphone et ordinateur. Jetons fictifs."
}
